#version 440
layout(location = 0) in vec2 texcoord;
layout(location = 0) out vec4 fragColor;
layout(std140, binding = 0) uniform buf { mat4 qt_Matrix; float qt_Opacity; float outerX; float outerY; float outerHX; float outerHY; float innerX; float innerY; float innerHX; float innerHY; float radius; float smoothing; float eigenvalue; int rectCount; vec4 innerRadii; vec4 color; vec4 outline; vec4 rects[16]; vec4 rectRadii[16]; };
float box(vec2 p, vec2 c, vec2 h) { vec2 q = abs(p - c) - h; return length(max(q, 0.0)) + min(max(q.x, q.y), 0.0); }
float cornerRadius(vec2 p, vec2 c, vec4 radii, vec2 h) { float r = p.x < c.x ? (p.y < c.y ? radii.x : radii.w) : (p.y < c.y ? radii.y : radii.z); return clamp(r, 0.0, min(h.x, h.y)); }
float roundBox(vec2 p, vec2 c, vec2 h, vec4 radii) { float r = cornerRadius(p, c, radii, h); vec2 q = abs(p - c) - h + r; return length(max(q, 0.0)) + min(max(q.x, q.y), 0.0) - r; }
float smin(float a, float b, float k) { k = max(0.001, k * eigenvalue); return max(k, min(a, b)) - length(max(vec2(k) - vec2(a, b), 0.0)); }
void main() { vec2 p = vec2(outerX - outerHX, outerY - outerHY) + texcoord * vec2(outerHX * 2.0, outerHY * 2.0); float distances[17]; distances[0] = max(box(p, vec2(outerX, outerY), vec2(outerHX, outerHY)), -roundBox(p, vec2(innerX, innerY), vec2(innerHX, innerHY), innerRadii)); for (int i = 0; i < rectCount; ++i) distances[i + 1] = roundBox(p, rects[i].xy, rects[i].zw, rectRadii[i]); float d = distances[0]; for (int i = 1; i <= rectCount; ++i) d = min(d, distances[i]); for (int i = 0; i <= rectCount; ++i) for (int j = i + 1; j <= rectCount; ++j) if (max(distances[i], distances[j]) < smoothing) d = min(d, smin(distances[i], distances[j], smoothing)); float aa = fwidth(d); float fillCoverage = 1.0 - smoothstep(-aa, aa, d); float outerCoverage = outline.a > 0.0 ? 1.0 - smoothstep(outline.a - aa, outline.a + aa, d) : 0.0; float strokeCoverage = max(0.0, outerCoverage - fillCoverage); float fillAlpha = fillCoverage * color.a; fragColor = vec4(color.rgb * fillAlpha + outline.rgb * strokeCoverage, fillAlpha + strokeCoverage) * qt_Opacity; }
