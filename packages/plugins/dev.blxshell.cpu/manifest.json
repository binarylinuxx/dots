{
  "$schema": "../../../schemas/manifest.schema.json",
  "schema": 1,
  "type": "plugin",
  "id": "dev.blxshell.cpu",
  "name": "CPU",
  "version": "1.0.0",
  "description": "CPU usage in the bar, as a ring and a percentage. Click for the load average, right click for the sidebar. An example plugin: a Facet view on a POSIX sh backend.",
  "authors": [
    "blxshell"
  ],
  "license": "MIT",
  "tags": [
    "system",
    "example"
  ],
  "project": "blxshell",
  "blxshell": ">=0.1.0",
  "compositors": [
    "any"
  ],
  "plugin": {
    "api": 2,
    "facet": "plugin.facet",
    "exec": [
      "bin/cpu.sh"
    ],
    "restart": "on-failure",
    "permissions": [
      "shell"
    ]
  }
}
