{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://blxshell.dev/schemas/manifest-1.json",
  "title": "blxshell package manifest",
  "description": "manifest.json at the root of a .blx package (a zstd-compressed tar). Schema version 1.",
  "type": "object",
  "required": [
    "schema",
    "type",
    "id",
    "name",
    "version",
    "compositors"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "schema": {
      "const": 1,
      "description": "Manifest format version. blxshell refuses manifests newer than it reads."
    },
    "type": {
      "enum": [
        "theme",
        "plugin"
      ]
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]*(\\.[a-z0-9_-]+)+$",
      "minLength": 3,
      "maxLength": 128,
      "description": "Reverse-DNS id, unique in the store, e.g. io.github.someone.glass. Also the install folder's name."
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "version": {
      "type": "string",
      "pattern": "^v?(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)([-+][0-9A-Za-z.-]+)?$",
      "description": "Semantic version of this package."
    },
    "description": {
      "type": "string",
      "maxLength": 500
    },
    "authors": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "type": "string"
          },
          {
            "type": "object",
            "required": [
              "name"
            ],
            "properties": {
              "name": {
                "type": "string"
              },
              "email": {
                "type": "string"
              },
              "url": {
                "type": "string"
              }
            },
            "additionalProperties": false
          }
        ]
      }
    },
    "license": {
      "type": "string",
      "description": "SPDX identifier, e.g. MIT, GPL-3.0-or-later."
    },
    "homepage": {
      "type": "string"
    },
    "repository": {
      "type": "string"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 32
      },
      "maxItems": 12
    },
    "icon": {
      "$ref": "#/$defs/packagePath"
    },
    "previews": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/packagePath"
      },
      "maxItems": 8
    },
    "project": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*$",
      "default": "blxshell",
      "description": "The project this package is for: \"blxshell\" (the default), or another shell that reuses this plugin system with its own project id. A build only installs its own project's packages."
    },
    "blxshell": {
      "type": "string",
      "description": "Versions of the project it works with: \"*\", \">=0.1.0\", \">=0.1.0 <0.3.0\", \"^0.1.0\", \"~0.1.2\", groups joined by \"||\"."
    },
    "compositors": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "anyOf": [
          {
            "enum": [
              "any",
              "zwwm",
              "hyprland",
              "halley"
            ]
          },
          {
            "type": "string",
            "pattern": "^[a-z0-9-]+$"
          }
        ]
      },
      "description": "Compositors it works under. blxshell won't apply or run it under others. \"any\" for all."
    },
    "plugin": {
      "$ref": "#/$defs/plugin"
    },
    "colours": {
      "$ref": "#/$defs/colours"
    },
    "wallpaper": {
      "allOf": [
        {
          "$ref": "#/$defs/packagePath"
        }
      ],
      "pattern": "\\.(png|jpe?g|webp|svg)$",
      "description": "Themes only: an image in the package that applying the theme sets as the wallpaper. With colours.source \"wallpaper\" the palette is generated from it."
    }
  },
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "type": {
            "const": "theme"
          }
        }
      },
      "then": {
        "required": [
          "colours"
        ],
        "not": {
          "required": [
            "plugin"
          ]
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "plugin"
          }
        }
      },
      "then": {
        "required": [
          "plugin"
        ],
        "not": {
          "anyOf": [
            {
              "required": [
                "colours"
              ]
            },
            {
              "required": [
                "wallpaper"
              ]
            }
          ]
        }
      }
    }
  ],
  "$defs": {
    "packagePath": {
      "type": "string",
      "pattern": "^(?!/)(?!.*(^|/)\\.\\.(/|$)).+$",
      "description": "A file inside the package, relative to its root."
    },
    "colour": {
      "type": "string",
      "pattern": "^#([0-9a-fA-F]{6}|[0-9a-fA-F]{8})$"
    },
    "role": {
      "enum": [
        "primary",
        "primaryText",
        "primaryContainer",
        "secondary",
        "secondaryContainer",
        "tertiary",
        "tertiaryContainer",
        "error",
        "errorText",
        "errorContainer",
        "errorContainerText",
        "surface",
        "surfaceContainer",
        "surfaceContainerLow",
        "surfaceContainerHigh",
        "surfaceContainerHighest",
        "surfaceVariant",
        "text",
        "textMuted",
        "outline",
        "outlineVariant"
      ]
    },
    "plugin": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "api"
      ],
      "description": "A plugin (api 2): any of facet, exec and native, at least one.",
      "properties": {
        "api": {
          "const": 2,
          "description": "Plugin API version."
        },
        "facet": {
          "allOf": [
            {
              "$ref": "#/$defs/packagePath"
            },
            {
              "pattern": "\\.facet$"
            }
          ],
          "description": "Its views in Facet, drawn by the shell: Bar… views are bar modules, Settings is its page in Settings."
        },
        "exec": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          },
          "prefixItems": [
            {
              "$ref": "#/$defs/packagePath"
            }
          ],
          "description": "A process behind it, in any language, speaking JSON lines on stdin/stdout."
        },
        "native": {
          "allOf": [
            {
              "$ref": "#/$defs/packagePath"
            },
            {
              "pattern": "\\.so$"
            }
          ],
          "description": "A C++ library (<blxshell/plugin.hpp>); runs inside the shell, so needs the native permission."
        },
        "restart": {
          "enum": [
            "never",
            "on-failure",
            "always"
          ],
          "default": "on-failure"
        },
        "permissions": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": [
              "shell",
              "notifications",
              "network",
              "filesystem",
              "spawn",
              "native"
            ]
          },
          "description": "shell, notifications and spawn gate requests to the shell; native is required for native code. All are shown to users and reviewers."
        },
        "lockMaterial": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "shader"
          ],
          "description": "A material for the lock screen: every backdrop there is drawn by this rectangle shader, which may sample the wallpaper behind it (VW_USE_BACKDROP). shader_params 0-2 come from the store keys in params, 3 is the item's opacity; the rectangle's colour is the backdrop colour, its alpha the user's Background setting.",
          "properties": {
            "shader": {
              "allOf": [
                {
                  "$ref": "#/$defs/packagePath"
                },
                {
                  "pattern": "\\.(vws|comp)$"
                }
              ],
              "description": "A .vws file (vw-shaderc, usually built by build.sh into lib/) or GLSL source compiled at runtime (needs glslc)."
            },
            "params": {
              "type": "array",
              "maxItems": 3,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "key"
                ],
                "properties": {
                  "key": {
                    "type": "string"
                  },
                  "default": {
                    "type": "number"
                  }
                }
              }
            },
            "data": {
              "type": "array",
              "maxItems": 32,
              "description": "More settings for the shader: store keys whose values (or defaults) reach it as shader_data, in order. The shader declares VW_USE_DATA.",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "key"
                ],
                "properties": {
                  "key": {
                    "type": "string"
                  },
                  "default": {
                    "type": "number"
                  }
                }
              }
            },
            "passes": {
              "type": "array",
              "maxItems": 32,
              "description": "Shader passes before the material's shader, in order (vw ShaderPass): each draws into a named float image (output) and reads earlier ones (inputs).",
              "items": {
                "type": "object",
                "required": [
                  "shader"
                ],
                "additionalProperties": false,
                "properties": {
                  "shader": {
                    "allOf": [
                      {
                        "$ref": "#/$defs/packagePath"
                      },
                      {
                        "pattern": "\\.(vws|comp)$"
                      }
                    ]
                  },
                  "output": {
                    "type": "string"
                  },
                  "inputs": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "params": {
                    "type": "array",
                    "maxItems": 4,
                    "items": {
                      "oneOf": [
                        {
                          "type": "number"
                        },
                        {
                          "type": "object",
                          "required": [
                            "key"
                          ],
                          "additionalProperties": false,
                          "properties": {
                            "key": {
                              "type": "string"
                            },
                            "default": {
                              "type": "number"
                            }
                          }
                        }
                      ]
                    }
                  },
                  "data": {
                    "type": "array",
                    "items": {
                      "oneOf": [
                        {
                          "type": "number"
                        },
                        {
                          "type": "object",
                          "required": [
                            "key"
                          ],
                          "additionalProperties": false,
                          "properties": {
                            "key": {
                              "type": "string"
                            },
                            "default": {
                              "type": "number"
                            }
                          }
                        }
                      ]
                    }
                  }
                }
              }
            },
            "inputs": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "The named images the material's shader reads, when there are passes."
            },
            "padding": {
              "type": "number",
              "minimum": 0,
              "maximum": 1024,
              "description": "How far the passes' images reach past each backdrop, px."
            },
            "passesWhen": {
              "type": "object",
              "required": [
                "key",
                "equals"
              ],
              "additionalProperties": false,
              "description": "Run the passes only while this store value equals the number.",
              "properties": {
                "key": {
                  "type": "string"
                },
                "equals": {
                  "type": "number"
                },
                "default": {
                  "type": "number"
                }
              }
            }
          }
        },
        "lockOptions": {
          "type": "object",
          "description": "Options of the plugin's Lock views, shown in the lock screen layout editor for each such widget. The view reads the widget's values (each declared default until set) as state.lock.options, or through Host::context() in C++.",
          "propertyNames": {
            "pattern": "^Lock"
          },
          "additionalProperties": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "key",
                "type"
              ],
              "additionalProperties": false,
              "properties": {
                "key": {
                  "type": "string",
                  "minLength": 1
                },
                "label": {
                  "type": "string"
                },
                "type": {
                  "enum": [
                    "toggle",
                    "choice",
                    "slider",
                    "text",
                    "colour"
                  ]
                },
                "default": {},
                "choices": {
                  "type": "array",
                  "items": {
                    "oneOf": [
                      {
                        "type": "string"
                      },
                      {
                        "type": "object",
                        "required": [
                          "value"
                        ],
                        "additionalProperties": false,
                        "properties": {
                          "value": {
                            "type": "string"
                          },
                          "label": {
                            "type": "string"
                          }
                        }
                      }
                    ]
                  }
                },
                "min": {
                  "type": "number"
                },
                "max": {
                  "type": "number"
                },
                "step": {
                  "type": "number"
                },
                "unit": {
                  "type": "string"
                },
                "placeholder": {
                  "type": "string"
                }
              }
            }
          }
        }
      },
      "anyOf": [
        {
          "required": [
            "facet"
          ]
        },
        {
          "required": [
            "exec"
          ]
        },
        {
          "required": [
            "native"
          ]
        },
        {
          "required": [
            "lockMaterial"
          ]
        }
      ],
      "if": {
        "required": [
          "native"
        ]
      },
      "then": {
        "properties": {
          "permissions": {
            "contains": {
              "const": "native"
            }
          }
        },
        "required": [
          "permissions"
        ]
      }
    },
    "colours": {
      "description": "A theme's colours: a fixed palette (static) or a matugen generation preset (generated).",
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "roles"
          ],
          "properties": {
            "kind": {
              "const": "static"
            },
            "roles": {
              "allOf": [
                {
                  "$ref": "#/$defs/roleMap"
                },
                {
                  "required": [
                    "primary",
                    "primaryText",
                    "primaryContainer",
                    "secondary",
                    "secondaryContainer",
                    "tertiary",
                    "tertiaryContainer",
                    "error",
                    "errorText",
                    "errorContainer",
                    "errorContainerText",
                    "surface",
                    "surfaceContainer",
                    "surfaceContainerLow",
                    "surfaceContainerHigh",
                    "surfaceContainerHighest",
                    "surfaceVariant",
                    "text",
                    "textMuted",
                    "outline",
                    "outlineVariant"
                  ]
                }
              ],
              "description": "Every role, fixed."
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind"
          ],
          "properties": {
            "kind": {
              "const": "generated"
            },
            "source": {
              "enum": [
                "wallpaper",
                "seed"
              ]
            },
            "seed": {
              "$ref": "#/$defs/colour"
            },
            "mode": {
              "enum": [
                "dark",
                "light"
              ]
            },
            "scheme": {
              "enum": [
                "tonal-spot",
                "content",
                "expressive",
                "fidelity",
                "fruit-salad",
                "monochrome",
                "neutral",
                "rainbow",
                "vibrant"
              ]
            },
            "contrast": {
              "type": "number",
              "minimum": -1,
              "maximum": 1
            },
            "prefer": {
              "enum": [
                "saturation",
                "darkness",
                "lightness"
              ]
            },
            "preset": {
              "enum": [
                "generated",
                "neutral",
                "amoled",
                "mono"
              ]
            },
            "roles": {
              "$ref": "#/$defs/roleMap",
              "description": "Roles pinned over the generated ones."
            }
          },
          "if": {
            "properties": {
              "source": {
                "const": "seed"
              }
            },
            "required": [
              "source"
            ]
          },
          "then": {
            "required": [
              "seed"
            ]
          }
        }
      ]
    },
    "roleMap": {
      "type": "object",
      "propertyNames": {
        "$ref": "#/$defs/role"
      },
      "additionalProperties": {
        "$ref": "#/$defs/colour"
      }
    }
  }
}
